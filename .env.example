# Northstar AI IT Help Desk configuration
# Copy this file to .env and fill in values if using Azure Claude.

# Use mock for local development/tests, or azure for Azure-hosted Claude.
MODEL_PROVIDER=mock

# Azure Claude / model gateway settings (leave blank for mock mode)
AZURE_CLAUDE_ENDPOINT=
AZURE_CLAUDE_API_KEY=
AZURE_CLAUDE_MODEL=
AZURE_CLAUDE_API_VERSION=

# Local paths
NORTHSTAR_DB_PATH=data/northstar_tickets.db
NORTHSTAR_KB_PATH=knowledge_base
